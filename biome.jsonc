{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // Recorded files a test writes and compares byte for byte: the planning goldens and the
    // launch characterization's record (R-B7).
    "includes": [
      "**",
      "!**/dist",
      "!pnpm-lock.yaml",
      "!packages/planning/golden",
      "!fixtures/launch-characterization.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // Strict mode with noUncheckedIndexedAccess makes `!` the marker for invariants the compiler cannot prove (R-I6).
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      // The non-null rule, file by file as R-B7 converts them (operator decision 6, 2026-10-17):
      // a production `!` that is wrong surfaces as an anonymous TypeError far from its cause, so
      // these files use `required` (packages/domain/src/invariant.ts), which names what was absent.
      // The scheduler half adds the files it moved or made (operator decision 4, 2026-10-21, which
      // amends decision 6); the rest convert after R-B7's third part, which turns the rule on
      // everywhere and removes this list.
      "includes": [
        "packages/domain/src/invariant.ts",
        "apps/server/src/services/agent-run-service.ts",
        "apps/server/src/services/run/**",
        "apps/server/src/services/work-cycle-service.ts",
        "apps/server/src/services/cycle/**",
        "apps/server/src/services/brief.ts",
        "apps/server/src/services/brief-handoff.ts",
        "apps/server/src/services/brief-review.ts",
        "apps/server/src/services/execution-scope.ts",
        "apps/server/src/services/brief-design.ts",
        "apps/server/src/services/brief-implement.ts",
        "apps/server/src/services/brief-output.ts",
        "apps/server/src/services/run-handoff.ts",
        "apps/server/src/services/run-lineage.ts",
        "apps/server/src/services/scope-resolution.ts",
        "apps/server/src/services/milestone-policy.ts",
        "apps/server/src/services/authority-policy.ts",
        "apps/server/src/services/command-bounds.ts",
        "apps/server/src/services/roadmap-service.ts",
        "apps/server/src/services/roadmap/**",
        "apps/server/src/services/roadmap-actor.ts",
        "apps/server/src/services/roadmap-settlement.ts",
        "apps/server/src/services/map-state.ts",
        "apps/server/src/services/cross-project-service.ts",
        "apps/server/src/services/execution-service.ts",
        "apps/server/src/services/merge/**",
        "apps/server/src/services/git-required.ts",
        "apps/server/src/services/workflow-policy.ts",
        "apps/server/src/services/cycle-priority.ts"
      ],
      "linter": { "rules": { "style": { "noNonNullAssertion": "error" } } }
    },
    {
      // Every spec takes `test` and `expect` from e2e/support.ts, whose fixture fails it on browser
      // errors (TS-M15). Only names that carry no fixture may come from Playwright directly; a
      // namespace or default import is refused too.
      "includes": ["e2e/**/*.spec.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@playwright/test": {
                    "allowImportNames": ["devices", "Browser", "BrowserContext", "Locator", "Page"],
                    "message": "Import test and expect from ./support: its fixture fails a spec on browser errors."
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
