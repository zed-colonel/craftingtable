{
  "name": "craftingtable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "tsc -b && pnpm run \"/^dev:/\"",
    "dev:types": "tsc -b --watch --preserveWatchOutput",
    "dev:server": "pnpm --filter @craftingtable/server dev",
    "dev:web": "pnpm --filter @craftingtable/web dev",
    "start": "pnpm --filter @craftingtable/server start",
    "craftingtable": "pnpm --filter @craftingtable/server cli",
    "craftingtable:dev": "pnpm --filter @craftingtable/server cli:dev",
    "db:migrate": "pnpm craftingtable db migrate",
    "deploy:daemon": "node scripts/deploy-daemon.mjs",
    "controller:replay": "pnpm --filter @craftingtable/server replay",
    "replays": "node scripts/replays.mjs",
    "db:status": "pnpm craftingtable db status",
    "db:verify": "pnpm --filter @craftingtable/server db-verify",
    "build": "tsc -b && pnpm --filter @craftingtable/web build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "typecheck": "tsc -b && tsc --noEmit -p apps/web && tsc --noEmit -p packages/git/tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "tsc -b && playwright test && CRAFTINGTABLE_WALKTHROUGH=rehearse playwright test --project=walkthrough",
    "ui:walkthrough": "tsc -b && CRAFTINGTABLE_WALKTHROUGH=1 playwright test --project=walkthrough",
    "check:scope": "node scripts/check-forbidden-scope.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm test:e2e && pnpm check:scope"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
